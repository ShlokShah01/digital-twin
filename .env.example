# --- LLM -------------------------------------------------------------------
# OpenAI-compatible endpoint (OpenAI, or any local server speaking
# /chat/completions e.g. Ollama/vLLM/LM Studio).
#
# NVIDIA NIM (build.nvidia.com) defaults:
#   OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
#   DIGITAL_TWIN_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b (primary)
#   DIGITAL_TWIN_LLM_FALLBACK_MODEL=openai/gpt-oss-20b (independent fallback)
#   DIGITAL_TWIN_LLM_TIMEOUT=20    # total retry deadline
#
# Two keys are supported (e.g. two NVIDIA `nvapi-...` keys): requests are
# round-robined across them, each capped at DIGITAL_TWIN_LLM_RPM per minute,
# and transient failures (429/5xx/network/empty) are retried with backoff,
# rotating keys. If the primary model keeps failing (or is retired/404), the
# streaming fallback switches model and key after one primary failure.
# Authentication errors fail immediately.
OPENAI_API_KEY=
OPENAI_API_KEY_2=
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
DIGITAL_TWIN_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
DIGITAL_TWIN_LLM_FALLBACK_MODEL=openai/gpt-oss-20b
DIGITAL_TWIN_LLM_CONTEXT=131072   # input token budget for docs/briefs
DIGITAL_TWIN_LLM_RPM=40

# --- data ------------------------------------------------------------------
DIGITAL_TWIN_RAW_DIR=data/raw
# DIGITAL_TWIN_DIR=data/twin          # outputs: lancedb/, graph.json, profile.json

# --- models ----------------------------------------------------------------
DIGITAL_TWIN_EMBED_MODEL=BAAI/bge-small-en-v1.5
# Laya checkpoint: "typed-decisions" (1024-token ctx, default), "multilingual"
# (1024/8192), or blank/unset for the English root card (512 ctx). There is no
# "english" subfolder. Laya-MLX is Apple-Silicon only; on this Windows box the
# cross-platform `laya` package is used.
DIGITAL_TWIN_LAYA_CHECKPOINT=typed-decisions
DIGITAL_TWIN_LAYA_DEVICE=cpu

# --- toggles ---------------------------------------------------------------
# DIGITAL_TWIN_NO_LLM=1     # skip all LLM features (offline mode)
# DIGITAL_TWIN_NO_LAYA=1    # skip Laya decisions/reranking

# --- RAG knobs -------------------------------------------------------------
# DIGITAL_TWIN_CHUNK_WORDS=150
# DIGITAL_TWIN_CHUNK_OVERLAP=30
# DIGITAL_TWIN_VECTOR_K=256
# DIGITAL_TWIN_GRAPH_K=12
# DIGITAL_TWIN_RETRIEVE_K=24
# DIGITAL_TWIN_RERANK_K=6
# DIGITAL_TWIN_COMMUNITY_K=3
# DIGITAL_TWIN_MAX_COMMUNITIES=12
# Interactive response budget; optional thinking mode for supported Nemotron models.
DIGITAL_TWIN_LLM_TIMEOUT=20
DIGITAL_TWIN_LLM_ATTEMPT_TIMEOUT=10
DIGITAL_TWIN_LLM_THINKING=false
